# 이 파일을 복사해서 .env.local 을 만들고, 아래 값을 채워 넣으세요.
#   mac/리눅스: cp env.sample .env.local
#   윈도우:     copy env.sample .env.local
# 값을 넣은 뒤에는 앱 켜기(npm run dev) 창을 껐다가 다시 켜야 반영됩니다.

# (선택) AI로 사진을 직접 그리게 하려면 필요합니다. 없어도 앱은 정상 동작합니다.
# Cloudflare 대시보드 > Workers AI 에서 발급합니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# (선택) 사용량 실측 조회에 필요합니다. 토큰에 "Account Analytics: Read" 권한이 있어야 합니다.
# 없으면 자체 로그 기반 추정치로 표시됩니다.

# (선택) claude 명령어 경로를 직접 지정해야 하는 경우에만 채우세요. 보통 비워두면 됩니다.
CLAUDE_BIN=
